  "paper": {
    "title": "KOR-Bench: Benchmarking Language Models on Knowledge-Orthogonal Reasoning Tasks",
    "url": "https://arxiv.org/abs/2410.06526",
    "conference": "ICLR 2025"
  },
  "protocol": {
    "adapter": "adapters/korbench.py",
    "default": "1,250 core items, zero-shot prompts",
    "core_counts": {
      "operation": 250,
      "logic": 250,
      "cipher": 250,
      "puzzle": 250,
      "counterfactual": 250
    },
    "rules_per_category": 25,
    "questions_per_rule": 10,
    "optional_loader": "load_cases(include_mixed=True)",
    "optional_mixed_counts": {
      "Multi-Q": 1000,
      "Multi-R": 1000,
      "Multi-RQ": 1000,
      "Multi-RQ_Hard": 4000
    },
    "all_cases_when_mixed_enabled": 8250,
    "prompt_sources": [
      "config/prompt/zero-shot.yaml",
      "config/prompt/mixed.yaml"
    ],
    "mixed_response_protocol": "JSON object; the official evaluator reads values in insertion order and aligns them with question_list."
  },
  "scoring": {
    "reference": "eval/eval_utils.py",
    "default_adapter_dependencies": "Python 3.10+ standard library only",
    "optional_symbolic_dependencies": [
      "sympy>=1.13.0",
      "antlr4-python3-runtime==4.11"
    ],
    "reference_requirements": [
      "transformers>=4.44.0",
      "vllm>=0.6.0",
      "tenacity>=9.0.0",
      "openai>=1.30.0",
      "prettytable>=3.0.0",
      "sympy>=1.13.0",
      "antlr4-python3-runtime==4.11"
    ],
    "notes": [
      "The adapter preserves the reference bracket extraction, category-specific comparisons, operation index exceptions, and mixed JSON value ordering.",
      "The adapter uses a restricted arithmetic AST for two puzzle checks instead of executing response text with the reference evaluator's eval calls.",
      "With SymPy and ANTLR installed, operation expression answers use parse_latex simplification; without them, the adapter follows the reference evaluator's cleaned-string fallback.",
      "On the pinned data, the reference scoring rules mark 12 gold responses incorrect: puzzle_11, puzzle_12, puzzle_18, puzzle_31, puzzle_32, puzzle_33, puzzle_35, puzzle_36, puzzle_37, puzzle_84, puzzle_93, puzzle_94. The adapter preserves those reference outcomes."
    ],
    "model_inference_performed": false
  },
